#!/bin/bash

# Function to display usage information
usage() {
    echo "Usage: $0 [-py] [-git] <project_name>"
    echo "Options:"
    echo "  -py    Create a Python virtual environment and a main.py file"
    echo "  -git   Initialize a Git repository"
    exit 1
}


# Function to list and select Python versions
select_python_version() {
    # Set the directory where Python installations are located
    python_dir="/tools/python"
    
    # List all directories that start with 'python' in the specified directory
    python_dirs=($(ls -d $python_dir/python*))
    python_versions=($(ls -d $python_dir/python* | awk -F'/' '{print $NF}'))

    # Check if any python versions are found
    if [ ${#python_versions[@]} -eq 0 ]; then
        echo "No Python versions found in $python_dir"
        exit 1
    fi

    # Print the list of Python versions
    echo "Available Python versions:"
    for i in "${!python_versions[@]}"; do
        echo "$((i+1)). ${python_versions[$i]}"
    done

    # Prompt the user to select a Python version
    read -p "Select a Python version by number: " selection

    # Validate the input
    if ! [[ $selection =~ ^[0-9]+$ ]] || [ $selection -lt 1 ] || [ $selection -gt ${#python_versions[@]} ]; then
        echo "Invalid selection. Please enter a number between 1 and ${#python_versions[@]}."
        exit 1
    fi

    # Return the selected Python version
    selected_python_version="${python_dirs[$((selection-1))]}"
    echo "Selected Python version: $selected_python_version"
}

# Check if no argument is provided
if [ $# -eq 0 ]; then
    usage
fi

# Parse options
create_python_env=0  # Flag to indicate whether to create Python virtual environment
init_git_repo=0      # Flag to indicate whether to initialize a Git repository

while getopts ":pygit" opt; do
    case ${opt} in
        p)
            create_python_env=1
            ;;
        g)
            init_git_repo=1
            ;;
        \?)
            echo "Invalid option: -$OPTARG" 1>&2
            usage
            ;;
    esac
done
shift $((OPTIND -1))

# Assign project name from argument
project_name="$1"
project_folder="$PWD/$project_name"

# Create project directory
mkdir -p "$project_folder"

# Generate README.md
cat << EOF > "$project_folder/README.md"
# ${project_name^^}

## Description
Add project description here.

## Modification
If moving the project to another folder, make sure to update the following:
    - modify the '${project_name^^}_DIR' environment variable in bin/run_$project_name.sh with the new path you're running from

## Todo
- [ ] Task 1
- [ ] Task 2
- [ ] Task 3

## Contributors
- Dan Osadtsuk <mailto:dano@xsightlabs.com>
EOF

# If flag is set to create Python virtual environment
if [ $create_python_env -eq 1 ]; then

    # Create requirements.txt
    touch $project_folder/requirements.txt

    # Select the Python version to use
    select_python_version

    # Create a Python virtual environment using the selected Python version
    "$selected_python_version/bin/python3" -m venv "$project_folder/.venv"

    # Get the Python version directory dynamically
    python_version_dir=$(ls -d "$project_folder/.venv/lib/python"* | head -n 1 | xargs -n 1 basename)

    # Declare VARS
    VENV_DIR="$project_folder/.venv"
    VENV_BIN="$VENV_DIR/bin"
    VENV_LIB="$VENV_DIR/lib"
    VENV_PKG="$VENV_LIB/$python_version_dir/site-packages"
    
    # Modify the activate script
    ACTIVATE_SCRIPT="$VENV_BIN/activate"
    if grep -q "export VIRTUAL_ENV" "$ACTIVATE_SCRIPT"; then
        sed -i "/export VIRTUAL_ENV/a export PYTHONPATH=\"$VENV_PKG\"" "$ACTIVATE_SCRIPT"
    else
        echo "export PYTHONPATH=\"$VENV_PKG\"" >> "$ACTIVATE_SCRIPT"
    fi

    # Modify the activate.csh script
    ACTIVATE_CSH_SCRIPT="$VENV_BIN/activate.csh"
    if grep -q "setenv VIRTUAL_ENV" "$ACTIVATE_CSH_SCRIPT"; then
        sed -i "/setenv VIRTUAL_ENV/a setenv PYTHONPATH \"$VENV_PKG\"" "$ACTIVATE_CSH_SCRIPT"
    else
        echo "setenv PYTHONPATH \"$VENV_PKG\"" >> "$ACTIVATE_CSH_SCRIPT"
    fi

    # Create a main.py file with shebang pointing to Python in the virtual environment
    cat << EOF > "$project_folder/main.py"
#!$project_folder/.venv/bin/python

# Your Python code starts here
import os

if __name__ == "__main__":
    print(f"Hello, {os.environ['USER']}!")
EOF
    # Create a pip.conf file in the .venv directory
    cat << EOF > "$project_folder/.venv/pip.conf"
[global]
target = $VENV_PKG
no-cache-dir = true
cache-dir = $VENV_LIB/pip-cache

[install]
ignore-installed = true
EOF

# Set execute permissions for main.py
chmod +x "$project_folder/main.py"

# Create a /bin folder
mkdir -p "$project_folder/bin"


# Create build.sh file
cat << EOF > "$project_folder/bin/build.sh"
#!/bin/bash

### Create python virtual environment ###
BUILD_DIR=\$(realpath "\$(dirname "\$0")/..")
PY_VER_PATH="${selected_python_version}/bin"
VENV_PATH="\${BUILD_DIR}/.venv"
echo "Installing python env to \$VENV_PATH"
\${PY_VER_PATH}/python -m venv \${VENV_PATH}

### Update target + cache_dir in pip.conf ###
cat << EOL > "\${VENV_PATH}/pip.conf"
[global]
target = \${VENV_PATH}/lib/$python_version_dir/site-packages
no-cache-dir = true
cache-dir = \${VENV_PATH}/lib/pip-cache

[install]
ignore-installed = true
EOL

### Install requirements.txt ###
echo "Entering virtual env"
source \${VENV_PATH}/bin/activate
echo "Installing requirements"
python -m pip install -r \${BUILD_DIR}/requirements.txt
echo "Finished installing requirements"
deactivate
EOF

chmod +x "$project_folder/bin/build.sh"

# Create a run.sh file inside /bin folder
cat << EOF > "$project_folder/bin/run_$project_name.sh"
#!/bin/bash

# Set tool directory environment variable
export ${project_name^^}_DIR=\$(realpath "\$(dirname "\$0")/..")

# Activate the virtual environment
source "\${${project_name^^}_DIR}/.venv/bin/activate"

# Set python module directory
export PYTHONPATH="\${${project_name^^}_DIR}/.venv/lib/$python_version_dir/site-packages"

# Update PATH
export PATH="\${${project_name^^}_DIR}/.venv/lib/$python_version_dir/site-packages:\$PATH"

# Update the shebang of main.py
sed -i "1s@.*@#!\${${project_name^^}_DIR}/.venv/bin/python@" "\${${project_name^^}_DIR}/main.py"

# Run main.py from project folder
\${${project_name^^}_DIR}/main.py "\$@"

# Deactivate the virtual environment
deactivate
EOF

    # Set execute permissions for run.sh
    chmod +x "$project_folder/bin/run_$project_name.sh"
fi

# If flag is set to initialize a Git repository
if [ $init_git_repo -eq 1 ]; then
    # Initialize Git repository
    cd "$project_folder" || exit
    git init -b main
    touch .gitignore

cat << EOF > "$project_folder/.gitignore"
# DIRS
/__pycache__
/.venv

# FILES
*.pyc
.env

EOF
fi

cat << EOF > "$project_folder/.env"
# Add environment variables here
PSWD = "123456789"

EOF

echo "Project '$project_name' created successfully in $project_folder."

if [ $create_python_env -eq 1 ]; then
    echo "To run the project, execute the following command: $project_folder/bin/run_$project_name.sh"
fi

exit 0
