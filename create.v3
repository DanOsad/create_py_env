#!/bin/bash

# Function to display usage information
usage() {
    echo "Usage: $0 [-py] [-git] <project_name>"
    echo "Options:"
    echo "  -py    Create a Python virtual environment and a main.py file"
    echo "  -git   Initialize a Git repository"
    exit 1
}

# Check if no argument is provided
if [ $# -eq 0 ]; then
    usage
fi

# Parse options
create_python_env=0  # Flag to indicate whether to create Python virtual environment
init_git_repo=0      # Flag to indicate whether to initialize a Git repository
while getopts ":pygit" opt; do
    case ${opt} in
        p)
            create_python_env=1
            ;;
        g)
            init_git_repo=1
            ;;
        \?)
            echo "Invalid option: -$OPTARG" 1>&2
            usage
            ;;
    esac
done
shift $((OPTIND -1))

# Assign project name from argument
project_name="$1"
project_folder="$PWD/$project_name"

# Create project directory
mkdir -p "$project_folder"

# Generate README.md
cat << EOF > "$project_folder/README.md"
# ${project_name^^}

## Description
Add project description here.

## Modification
If moving the project to another folder, make sure to update the following:
    - modify the '${project_name^^}_DIR' environment variable in bin/run_$project_name.sh with the new path you're running from

## Todo
- [ ] Task 1
- [ ] Task 2
- [ ] Task 3

## Contributors
- Dan Osadtsuk <mailto:dano@xsightlabs.com>
EOF

# If flag is set to create Python virtual environment
if [ $create_python_env -eq 1 ]; then
    # Create requirements.txt
    touch $project_folder/requirements.txt

    # Create a Python virtual environment
    python3 -m venv "$project_folder/venv"

    # Create a main.py file with shebang pointing to Python in the virtual environment
    cat << EOF > "$project_folder/main.py"
#!$project_folder/venv/bin/python

# Your Python code starts here
import os

if __name__ == "__main__":
    print(f"Hello, {os.environ['USER']}!")
EOF

# Set execute permissions for main.py
chmod +x "$project_folder/main.py"

# Create a /bin folder
mkdir -p "$project_folder/bin"

# Create a run.sh file inside /bin folder
cat << EOF > "$project_folder/bin/run_$project_name.sh"
#!/bin/bash

# Set tool directory environment variable
export ${project_name^^}_DIR="$project_folder"

# Activate the virtual environment
source "\${${project_name^^}_DIR}/venv/bin/activate"

# Update PATH
export PATH="\${${project_name^^}_DIR}/venv/lib/python3.6/site-packages:\$PATH"

# Update the shebang of main.py
sed -i "1s@.*@#!\${${project_name^^}_DIR}/venv/bin/python@" "\${${project_name^^}_DIR}/main.py"

# Run main.py from project folder
\${${project_name^^}_DIR}/main.py "@"

# Deactivate the virtual environment
deactivate
EOF

    # Set execute permissions for run.sh
    chmod +x "$project_folder/bin/run_$project_name.sh"
fi

# If flag is set to initialize a Git repository
if [ $init_git_repo -eq 1 ]; then
    # Initialize Git repository
    cd "$project_folder" || exit
    git init
    touch .gitignore

cat << EOF > "$project_folder/.gitignore"
# DIRS
/__pycache__
/venv

# FILES
*.pyc
.env

EOF
fi

echo "Project '$project_name' created successfully in $project_folder."

if [ $create_python_env -eq 1 ]; then
    echo "To run the project, execute the following command: $project_folder/bin/run_$project_name.sh"
fi

exit 0
